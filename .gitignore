# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Le gabarit, lui, est versionné : il documente les variables à renseigner.
!.env.example

# journal du serveur de développement
dev.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Outillage des assistants de code. Les trois dossiers vendorisent la même
# documentation Prisma, régénérable à partir de skills-lock.json : la versionner
# triplerait le nombre de fichiers du dépôt sans rien apporter au site.
/.agents
/.claude
/.windsurf
