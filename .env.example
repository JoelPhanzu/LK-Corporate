# ---------------------------------------------------------------------------
# Gabarit des variables d'environnement de LK-CORPORATE.
# Copier en `.env` et renseigner. Ne jamais versionner le `.env` renseigné.
#
# Développement et production sont DEUX PROJETS SUPABASE DISTINCTS. Chacun
# porte sa propre base, son propre stockage et son propre annuaire de comptes.
# Ce fichier décrit donc un seul environnement à la fois : celui de la machine
# ou du serveur où il est déposé.
# ---------------------------------------------------------------------------

# Environnement visé par les scripts d'outillage : `developpement` ou
# `production`. Rien dans les URL ne permet de distinguer les deux projets,
# c'est donc cette variable qui tranche. En production, elle fait refuser les
# commandes destructrices, `npm run db:migrer` en tête.
ENVIRONNEMENT="developpement"

# Base Postgres (Supabase > Project Settings > Database > Connection string).
# Utiliser l'URL « pooler » (port 6543) pour l'application.
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@HOTE:6543/postgres?pgbouncer=true"
# URL directe (port 5432), requise par les migrations Prisma : le pooler de
# transactions refuse les commandes DDL.
DIRECT_URL="postgresql://postgres:MOT_DE_PASSE@HOTE:5432/postgres"

# Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL="https://VOTRE_PROJET.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Clé de service : contourne les règles RLS. Strictement côté serveur,
# jamais préfixée NEXT_PUBLIC_, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=""

# URL publique du site, utilisée par les métadonnées et les liens absolus.
# En développement : http://localhost:3000
# En production : le domaine réel, sans barre oblique finale.
#
# ⚠ Cette variable, comme toutes les NEXT_PUBLIC_, est figée dans le bundle au
# moment de `npm run build`. La renseigner APRÈS la compilation n'a aucun effet.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
