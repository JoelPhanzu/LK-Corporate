# ---------------------------------------------------------------------------
# Gabarit des variables d'environnement de LK-CORPORATE.
# Copier en `.env` et renseigner. Ne jamais versionner le `.env` renseigné.
# ---------------------------------------------------------------------------

# Base Postgres (Supabase > Project Settings > Database > Connection string).
# Utiliser l'URL « pooler » (port 6543) pour l'application.
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@HOTE:6543/postgres?pgbouncer=true"
# URL directe (port 5432), requise par les migrations Prisma.
DIRECT_URL="postgresql://postgres:MOT_DE_PASSE@HOTE:5432/postgres"

# Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL="https://VOTRE_PROJET.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Clé de service : contourne les règles RLS. Strictement côté serveur,
# jamais préfixée NEXT_PUBLIC_, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=""

# URL publique du site, utilisée par les métadonnées et les liens absolus.
NEXT_PUBLIC_SITE_URL="https://lk-corporate.com"
